<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBrush" Color="#337A2C" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4A9C3D" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#296621" />
    <SolidColorBrush x:Key="AccentBrush" Color="#19A337" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />

    <SolidColorBrush x:Key="BgWindowBrush" Color="#09090B" />
    <SolidColorBrush x:Key="BgBaseBrush" Color="#18181B" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#27272A" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#0F0F11" />
    <SolidColorBrush x:Key="BgSidebarHoverBrush" Color="#27272A" />
    <SolidColorBrush x:Key="BgSidebarActiveBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#27272A" />
    <SolidColorBrush x:Key="BgInputBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="BgInputFocusedBrush" Color="#52525B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#09090B" />

    <SolidColorBrush x:Key="BorderLightBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="#52525B" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#337A2C" />

</ResourceDictionary>
